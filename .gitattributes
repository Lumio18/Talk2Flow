# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Declare binary files (no line ending conversion)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
